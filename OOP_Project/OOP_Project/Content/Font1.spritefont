<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
	<Asset Type="Graphics:FontDescription">
		<!-- Имя шрифта. Arial есть на любой Windows. 
         Если делаете кроссплатформенную игру, лучше положить .ttf файл рядом и написать его имя -->
		<FontName>Arial</FontName>

		<Size>16</Size>
		<Spacing>1</Spacing>
		<UseKerning>true</UseKerning>
		<Style>Regular</Style>

		<!-- Символ, который будет рисоваться, если в шрифте нет нужной буквы -->
		<DefaultCharacter>?</DefaultCharacter>

		<CharacterRegions>
			<!-- 1. Базовый набор (ASCII): цифры, латиница, точка, запятая, скобки, двоеточие (32 - 126) -->
			<!-- Это решит проблему с падением игры при выводе переменных вроде Vector2.ToString() -->
			<CharacterRegion>
				<Start>32</Start>
				<End>126</End>
			</CharacterRegion>

			<!-- 2. Русский алфавит: от 'А' до 'я' -->
			<CharacterRegion>
				<Start>1040</Start>
				<End>1103</End>
			</CharacterRegion>

			<!-- 3. Буква 'Ё' -->
			<CharacterRegion>
				<Start>1025</Start>
				<End>1025</End>
			</CharacterRegion>

			<!-- 4. Буква 'ё' -->
			<CharacterRegion>
				<Start>1105</Start>
				<End>1105</End>
			</CharacterRegion>
		</CharacterRegions>
	</Asset>
</XnaContent>
